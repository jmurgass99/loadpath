{
  "name": "@loadpath/web",
  "version": "0.1.1",
  "description": "Ultralight VanJS + Three.js + WebAssembly 3D frame and semi-rigid connection analyzer with GeometryMapping",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "node src/__tests__/loadpathWeb.test.ts",
    "build:wasm": "emcc ./src/solver/cpp/lSolver.cpp -o ./src/solver/cpp/built/lSolver.wasm -O3 -s STANDALONE_WASM --no-entry -s EXPORTED_FUNCTIONS=_monfortonFixityFactor,_beamFlexuralStiffness"
  },
  "dependencies": {
    "three": "^0.170.0",
    "vanjs-core": "^1.5.2"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
